# Servidor TURN para llamadas (necesario cuando los teléfonos están en redes
# distintas, con datos móviles o en wifi con aislamiento de clientes).
#
# Opción gratuita: crear cuenta en https://www.metered.ca (50 GB/mes gratis),
# copiar las credenciales TURN aquí y reconstruir el frontend.
# Opción propia: montar coturn (https://github.com/coturn/coturn).
#
# VITE_TURN_URLS=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turn:a.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=tu_usuario
# VITE_TURN_CREDENTIAL=tu_clave
